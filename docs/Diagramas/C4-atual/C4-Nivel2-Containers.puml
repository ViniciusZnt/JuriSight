@startuml
skinparam linetype ortho
skinparam nodesep 150
skinparam ranksep 160
skinparam ArrowFontSize 10
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title JuriSight — Nível 2: Containers

Person(user, "Advogado / Assistente Jurídico", "Usuário do sistema")

System_Ext(falcao, "Jurisprudência Nacional da JT (Falcão)", "jurisprudencia.jt.jus.br")
System_Ext(openai, "OpenAI", "Embeddings, triagem e resposta")
System_Ext(jev, "Typesafe — Jev", "Provimento")

System_Boundary(jurisight, "JuriSight") {

    Container(caddy, "Proxy reverso", "Caddy 2", "HTTPS automático (Let's Encrypt) e HSTS.\n/ → web · /api → api · bloqueia /api/metrics.")
    Container(frontend, "Front-end", "Next.js 16 + React 19", "Home, revisão de contexto, resultados com triagem\nprogressiva, detalhe, salvos, conta e guia de uso.")
    Container(backend, "Backend API", "FastAPI", "Enriquecimento da consulta, busca híbrida (RRF),\nfiltro restrito, triagem, resposta, contas e histórico.")
    Container(ollama, "LLM local", "Ollama — Llama 3.2 3B", "Extrai a estrutura argumentativa do PDF/tese\ne resume PDFs longos (o PDF não sai do servidor).")

    ContainerDb(postgres, "Banco relacional", "PostgreSQL 16", "Fonte da verdade: acórdãos, provimento (Jev),\ndispositivos, contas, conversas, caches e uso diário.")
    ContainerDb(qdrant, "Banco vetorial", "Qdrant", "2 coleções: chunks_completo (por trecho)\ne chunks_ementa (por acórdão).")
    ContainerDb(bm25, "Índice BM25", "bm25s (mmap em ./data)", "Índice lexical dos trechos.\nGravado pelo pipeline, lido pelo backend.")

    Container(pipeline, "Pipeline de dados", "Dagster + requests + Playwright", "Coleta → índices → filtros → provimento (Jev).\nRetomável, um run por vez.")
    Container(obs, "Observabilidade", "Prometheus · Grafana · Loki · Alloy", "Métricas, saúde dos serviços, logs\ne painel JuriSight.")
}

' ========== LAYOUT ==========
' Linha 1: acesso + observabilidade
Lay_U(caddy, user)
Lay_R(caddy, frontend)
Lay_R(frontend, obs)
' Linha 2: backend e IA
Lay_D(frontend, backend)
Lay_R(backend, ollama)
Lay_R(ollama, openai)
' Linha 3: dados
Lay_D(backend, qdrant)
Lay_R(bm25, qdrant)
Lay_R(qdrant, postgres)
' Linha 4: pipeline e fontes externas
Lay_D(qdrant, pipeline)
Lay_R(pipeline, jev)
Lay_L(pipeline, falcao)

' ========== RELAÇÕES ==========
Rel_D(user, caddy, "Acessa pelo navegador", "HTTPS")
Rel_R(caddy, frontend, "Páginas", "HTTP")
Rel(caddy, backend, "/api", "REST/JSON")
Rel_D(frontend, backend, "REST/JSON (cookie httpOnly)")
Rel(obs, backend, "/metrics, saúde e logs")

Rel_R(backend, ollama, "Estrutura argumentativa (JSON)")
Rel_R(backend, openai, "Embedding da tese, triagem, resposta")
Rel(backend, postgres, "Documentos, contas, conversas, caches")
Rel(backend, qdrant, "Busca vetorial + filtros")
Rel(backend, bm25, "Busca lexical (mmap)")

Rel(pipeline, postgres, "Persiste acórdãos e provimento")
Rel(pipeline, qdrant, "Indexa trechos e ementas")
Rel(pipeline, bm25, "Grava o índice (troca atômica)")
Rel(pipeline, openai, "Embeddings dos trechos")
Rel_R(pipeline, jev, "Classifica o provimento")
Rel_L(pipeline, falcao, "Coleta (API pública + sessão de navegador)")

SHOW_LEGEND()
@enduml
