
# ChromaDB (persistência local)
CHROMA_PERSIST_DIR=./data/index/chroma
BM25_INDEX_PATH=./data/index/bm25.pkl

# PostgreSQL (source of truth)
DATABASE_URL=postgresql://postgres:postgres@localhost:port/jurisight

# Configurações do scraper
