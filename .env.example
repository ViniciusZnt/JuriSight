
# Qdrant (banco vetorial — substituiu o ChromaDB embedded, ver README §Escalabilidade)
QDRANT_URL=http://localhost:6333
BM25_INDEX_PATH=./data/index/bm25s_index

# PostgreSQL (source of truth)
DATABASE_URL=postgresql://postgres:postgres@localhost:port/jurisight

# Autenticação real (auth/tokens.py) — SEM valor padrão de propósito (um
# fallback tipo "changeme" seria uma vulnerabilidade). Gere a sua:
# `openssl rand -hex 32`
JWT_SECRET_KEY=
# true só em produção com HTTPS.
COOKIE_SECURE=false

# Configurações do scraper
TST_BASE_URL=https://jurisprudencia.tst.jus.br
SCRAPER_DELAY=2
SCRAPER_MAX_PAGES=100

# Embeddings (OpenAI)
OPENAI_API_KEY=sk-...
OPENAI_EMBED_MODEL=text-embedding-3-small

# TypeSafe (System One / Jev) — juiz de relevância e stance do harness de avaliação.
# O SDK (`typesafe-sdk`) lê TYPESAFE_API_KEY. Modelo fixado de propósito: o alias
# `jev-latest` muda sozinho e invalidaria a comparação entre rodadas de avaliação.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0

# LLM local (Ollama) — enriquecimento de query (RF02) e sumarização de PDFs longos (FA04)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# API (FastAPI/Uvicorn)
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:3000