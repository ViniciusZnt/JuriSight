
# ChromaDB (persistência local)
# No WSL2, aponte para o FS Linux (~), NÃO para /mnt/d: escrever no drive Windows
# (v9fs) é ~34x mais lento por fsync e o Chroma grava a cada documento.
CHROMA_PERSIST_DIR=~/.local/share/jurisight/chroma
BM25_INDEX_PATH=./data/index/bm25.pkl

# PostgreSQL (source of truth)
DATABASE_URL=postgresql://postgres:postgres@localhost:port/jurisight

# Configurações do scraper
TST_BASE_URL=https://jurisprudencia.tst.jus.br
SCRAPER_DELAY=2
SCRAPER_MAX_PAGES=100

# Embeddings (OpenAI)
OPENAI_API_KEY=sk-...
OPENAI_EMBED_MODEL=text-embedding-3-small