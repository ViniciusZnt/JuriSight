# Ollama (roda localmente — sem chave necessária)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ChromaDB (persistência local)
CHROMA_PERSIST_DIR=./data/index

# PostgreSQL (source of truth)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jurisight

# Configurações do scraper
TST_BASE_URL=https://jurisprudencia.tst.jus.br
SCRAPER_DELAY=2
SCRAPER_MAX_PAGES=100
