# .env de produção (VPS). Copie para .env, preencha e rode `chmod 600 .env`. Nunca versione o .env.

# Domínio público (sem https://). Sem domínio próprio: <ip-com-hífens>.sslip.io
DOMINIO=

# Postgres (senha nova: openssl rand -hex 24) — a mesma senha vai no DATABASE_URL
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@postgres:5432/jurisight

# Serviços internos do compose
QDRANT_URL=http://qdrant:6333
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
BM25_INDEX_PATH=/app/data/index/bm25s_index

# Sessão: segredo novo (openssl rand -hex 32), cookie só em HTTPS, só a própria origem
JWT_SECRET_KEY=
COOKIE_SECURE=true
CORS_ORIGINS=https://<DOMINIO>

# OpenAI (embedding da consulta)
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# Jev — só se for rodar `provimento_jev_cli classificar` no servidor; a busca não usa
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0

# Limite diário por ação paga (enrich, query, resposta gerada). Por conta e somando todas as contas.
LIMITE_DIARIO_POR_CONTA=30
LIMITE_DIARIO_TOTAL=300

# Tamanho máximo do PDF da busca, em MB (o Caddy recusa corpos acima de 25 MB).
MAX_PDF_MB=20
